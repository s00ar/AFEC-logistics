# Repository-root deployment on Apache / compatible LiteSpeed hosting.
# Fail closed: only the application entries and known static assets are public.
Options -Indexes
DirectoryIndex index.php

RewriteEngine On
RewriteRule ^(?:index\.php)?$ - [L]
RewriteRule ^api/index\.php$ - [L]
RewriteRule ^public/assets/css/app\.css$ - [L]
RewriteRule ^public/assets/js/(?:app|http|planning|logistics|accounts|quick-load|account-security|carrier-load|starfield)\.js$ - [L]
RewriteRule ^public/assets/img/afec-logistica\.png$ - [L]
RewriteRule "^public/assets/images/Emblema AFEC Logística Espacial\.png$" - [L]
RewriteRule ^ - [F,L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
